  "definitions": {
    "attempts": {
      "required": [
        "id",
        "user_id",
        "exam_id",
        "mode"
      ],
      "properties": {
        "id": {
          "default": "extensions.uuid_generate_v4()",
          "description": "Note:\nThis is a Primary Key.<pk/>",
          "format": "uuid",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "type": "string"
        },
        "exam_id": {
          "format": "text",
          "type": "string"
        },
        "mode": {
          "default": "practice",
          "format": "text",
          "type": "string"
        },
        "score": {
          "format": "numeric",
          "type": "number"
        },
        "percentage": {
          "format": "numeric",
          "type": "number"
        },
        "correct_count": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "incorrect_count": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "unanswered_count": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "total_questions": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "answers": {
          "format": "jsonb"
        },
        "events": {
          "format": "jsonb"
        },
        "deadline": {
          "format": "timestamp with time zone",
          "type": "string"
        },
        "status": {
          "default": "submitted",
          "format": "text",
          "type": "string"
        },
        "created_at": {
          "default": "now()",
          "format": "timestamp with time zone",
          "type": "string"
        }
      },
